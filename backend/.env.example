PORT=3000
# From the Alexa developer console: Build > Endpoint > "Your Skill ID"
ALEXA_SKILL_ID=
# Set to false ONLY for local testing with fake Alexa requests
VERIFY_ALEXA_SIGNATURE=true
# Any long random string; the website and phone app send it as the x-api-key header
API_KEY=
# Google Cloud console > APIs > YouTube Data API v3 > Credentials > API key
YOUTUBE_API_KEY=
# MongoDB Atlas > Connect > Drivers. Without it, to-dos are lost when the server restarts.
MONGODB_URI=
